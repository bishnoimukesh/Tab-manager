{
  "manifest_version": 3,
  "name": "Tab Manager",
  "version": "1.1.0",
  "description": "A modern tab and productivity manager.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "favicon.ico",
      "48": "logo192.png",
      "128": "logo512.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "favicon.ico",
    "48": "logo192.png",
    "128": "logo512.png"
  },
  "permissions": [],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
